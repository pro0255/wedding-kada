{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test lib/*.test.ts",
    "check": "oxfmt --check && oxlint -c .oxlintrc.json && npm test && next build",
    "postinstall": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint --fix -c .oxlintrc.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "node --env-file-if-exists=.env.local node_modules/knip/bin/knip.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "gsap": "^3.15.1",
    "maplibre-gl": "^6.18.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
